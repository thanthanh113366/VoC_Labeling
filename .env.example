# Sao chép thành .env rồi điền giá trị thật (file .env đã bị .gitignore).
#
# Bật/tắt đăng nhập: chỉ cần có ít nhất một mật khẩu bên dưới.
# Bỏ trống hết => app chạy không cần đăng nhập (chỉ dùng khi thử local).

# ─── Tài khoản ───────────────────────────────────────────────
USER_A_NAME=a
USER_A_PASSWORD=

USER_B_NAME=b
USER_B_PASSWORD=

USER_ADJ_NAME=adj
USER_ADJ_PASSWORD=

# Khoá ký cookie session. Để trống thì hệ thống tự suy ra từ các mật khẩu
# (đổi mật khẩu = mọi session cũ hết hiệu lực).
SESSION_SECRET=

# ─── Turso (bỏ trống = dùng SQLite local) ────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
